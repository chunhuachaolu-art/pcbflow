{
 "algorithm_spec": {
  "failure_modes_covered": "naive 词表重数（对全语料数关键词出现次数）对不上注册算法——必须按本步骤顺序做逐旗互斥裁决（r25 教训：开源件必须包含算法本身，不能只给词表）。",
  "match_recording": "分类同时记录全部词表命中（matched 块）作为审计证据；命中记录不影响互斥裁决顺序。",
  "steps_in_implementation_order": [
   {
    "condition": "blackdot_terms 任一命中 AND uncertainty_terms 任一命中",
    "family": "existence_blackdot",
    "note": "黑点族先于 contact：黑点旗中的接触措辞描述点-盘邻接，弃权主因为黑点性质/存在性不明（预注册理由，见 priority_adjudication_note）",
    "order": 1
   },
   {
    "condition": "contact_terms 任一命中 AND contact_doubt_patterns (P1–P7) 任一命中 AND text_primary 全未命中",
    "family": "contact",
    "note": "文本主因（丝印/文字域）旗不归 contact——其「叠压」属文字叠印语境",
    "order": 2
   },
   {
    "condition": "explicit_existence_terms 任一命中",
    "family": "existence_other",
    "note": "显式存在性/性质具名疑因，先于 semantic_confusion（预注册优先级 3>4）",
    "order": 3
   },
   {
    "condition": "semantic_terms 任一命中（且步骤 1–3 全未命中）",
    "family": "semantic_confusion",
    "note": "仅当旗无任何显式存在性/性质语言、而以设计含义/归类/层归属为唯一具名疑因",
    "order": 4
   },
   {
    "condition": "generic_existence_patterns (G1–G8) 任一命中（且步骤 1–4 全未命中）",
    "family": "existence_other",
    "note": "仅泛化不确定性语言（无法确认/判断等）无具名疑因者归 existence_other 兜底",
    "order": 5
   },
   {
    "condition": "以上皆未命中（残余类）",
    "family": "other",
    "note": "",
    "order": 6
   }
  ],
  "unit_of_classification": "每条 abstain=true 旗标的 location_evidence 全文（辅以 category 但 category 不参与关键词判定）；互斥单族输出。"
 },
