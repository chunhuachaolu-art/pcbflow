{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fail-event.v1.schema.json",
  "title": "OPT-07 R4-B failure event contract (fail-event.v1)",
  "description": "EXEC-R4-B opt-in 失败事件契约：event_id=sha256(canonical(payload-{event_id,runtime}))；blocker/available_layers/topology/capacity_cert 口径见 v5.failure_events 模块 docstring（GATE-G1-RULING R4B-03/04）。volatile 字段单列 runtime 键、不入 event_id。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "fail_kind",
    "scope",
    "stage",
    "attempts",
    "cause",
    "geom_secondary",
    "blocker_nets",
    "available_layers",
    "tried_layers",
    "topology",
    "capacity_cert",
    "bindings",
    "event_seq"
  ],
  "properties": {
    "schema_version": {"const": "fail-event.v1"},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fail_kind": {"enum": ["sealed_short_circuit", "fixed_shape_failed", "net_exhausted", "final_check_infeasible", "candidate_failed"]},
    "scope": {"enum": ["net", "candidate"]},
    "stage": {"enum": ["preflight_seal", "fixed_shape", "attempt_ladder_ripup", "final_route_check", "candidate_close"]},
    "attempts": {"type": "integer", "minimum": 0},
    "cause": {"type": "string", "minLength": 1},
    "geom_secondary": {"type": "string"},
    "blocker_nets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "measured", "semantics_note"],
      "properties": {
        "kind": {"enum": ["computed_selection", "geometric_blocking_evidence", "not_available"]},
        "measured": {"type": "boolean"},
        "semantics_note": {"type": "string", "minLength": 1},
        "net_ids": {"type": "array", "items": {"type": "string"}},
        "selection_rule": {"type": "string", "minLength": 1},
        "measurement_stage": {"type": "string"},
        "measurement_reach_mm": {"type": ["number", "null"]},
        "ripup_round": {"type": ["integer", "null"]},
        "joint_factor": {"type": ["number", "null"]},
        "detail": {"type": "string"},
        "reason": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["computed_selection", "geometric_blocking_evidence"]}}},
          "then": {"required": ["net_ids", "selection_rule", "measurement_stage"]}
        },
        {
          "if": {"properties": {"kind": {"const": "not_available"}}},
          "then": {"required": ["reason"]}
        }
      ]
    },
    "available_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "layers", "source"],
      "properties": {
        "kind": {"enum": ["stackup_signal_available", "not_available"]},
        "layers": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string", "minLength": 1},
        "reason": {"type": "string"}
      }
    },
    "tried_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"enum": ["measured", "not_available"]},
        "layers": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoints", "edges", "edges_computed", "edge_order_source"],
      "properties": {
        "partition_id": {"type": ["string", "null"]},
        "net_id": {"type": ["string", "null"]},
        "endpoints": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["edge_id", "a", "b"],
            "properties": {
              "edge_id": {"type": "string", "minLength": 1},
              "a": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
              "b": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
            }
          }
        },
        "edges_computed": {"type": "boolean"},
        "edge_order_source": {"enum": ["board_topology_dfs", "mst_fallback", "topology_hints", "not_computed_preflight", "not_computed_fixed_shape", "not_computed_candidate_scope"]}
      }
    },
    "capacity_cert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority", "scope", "units", "corridors"],
      "properties": {
        "status": {"enum": ["verified", "not_available", "unknown"]},
        "authority": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "units": {"const": "mm"},
        "corridors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["corridor_layer_id", "capacity_mm", "terms", "occupancy_mm", "spacing_mm", "arithmetic", "entries_count"],
            "properties": {
              "corridor_layer_id": {"type": "string", "minLength": 1},
              "capacity_mm": {"type": "number", "exclusiveMinimum": 0},
              "terms": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
              "occupancy_mm": {"type": "number", "minimum": 0},
              "spacing_mm": {"type": "number", "minimum": 0},
              "arithmetic": {"type": "string", "minLength": 1},
              "entries_count": {"type": "integer", "minimum": 1}
            }
          }
        },
        "cert_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "cross_check": {"enum": ["agree", "mismatch", "not_available", "unknown"]},
        "reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}},
          "then": {"required": ["cert_sha256", "cross_check"], "properties": {"corridors": {"minItems": 1}}}
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor_version", "board_id", "board_sha256", "routes_schema_version", "candidate_sha256", "geometry_semantics", "world_id", "state_sha256", "parent_fail_event_id", "routes_sha256"],
      "properties": {
        "executor_version": {"type": "string", "minLength": 1},
        "board_id": {"type": ["string", "null"]},
        "board_sha256": {"type": ["string", "null"]},
        "routes_schema_version": {"type": "string", "minLength": 1},
        "candidate_sha256": {"type": ["string", "null"]},
        "geometry_semantics": {"type": "object"},
        "world_id": {"type": "string", "minLength": 1},
        "state_sha256": {"type": ["string", "null"]},
        "parent_fail_event_id": {"type": ["string", "null"]},
        "routes_sha256": {"type": ["string", "null"]}
      }
    },
    "event_seq": {"type": "integer", "minimum": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_seq_written": {"type": "integer", "minimum": 1},
        "wall_t": {"type": "string"},
        "mono_t": {"type": "number"},
        "pid": {"type": "integer"},
        "process_identity": {"type": "object"}
      }
    }
  }
}
